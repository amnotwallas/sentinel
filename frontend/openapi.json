            "title": "Postgres",
            "type": "string"
          },
          "status": {
            "enum": ["ready", "unavailable"],
            "title": "Status",
            "type": "string"
          },
          "tempo": {
            "enum": ["available", "unavailable"],
            "title": "Tempo",
            "type": "string"
          }
        },
        "required": ["status", "postgres", "tempo"],
        "title": "Readiness",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Sentinel",
    "version": "0.1.0"
  },
