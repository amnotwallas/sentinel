{
  "components": {
    "schemas": {
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "required",
              "type_invalid",
              "value_invalid",
              "extra_field",
              "limit_exceeded",
              "duplicate",
              "invalid_uuid",
              "invalid_url",
              "invalid_json_pointer",
              "invalid_secret_reference",
              "secret_placement_forbidden",
              "credential_literal_forbidden",
              "trace_context_forbidden",
              "unsafe_replay_acknowledgement_required",
              "incompatible_fields",
              "cursor_invalid"
            ],
            "title": "Code",
            "type": "string"
          },
          "location": {
            "enum": ["body", "path", "query", "header"],
            "title": "Location",
            "type": "string"
          },
          "message": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "pointer": {
            "title": "Pointer",
            "type": "string"
          }
        },
        "required": ["location", "pointer", "code", "message"],
        "title": "FieldError",
        "type": "object"
      },
      "Liveness": {
        "properties": {
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Liveness",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "validation_failed",
              "secret_reference_invalid",
              "resource_not_found",
              "revision_conflict",
              "revision_precondition_required",
              "resource_conflict",
              "request_too_large",
              "unsupported_media_type",
              "authentication_required",
              "forbidden_origin",
              "idempotency_conflict",
              "baseline_ineligible",
              "baseline_incompatible",
              "internal_error",
              "http_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Errors",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "type": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["type", "title", "status", "code"],
        "title": "Problem",
        "type": "object"
      },
      "Project": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "deleted_at": {
            "title": "Deleted At",
            "type": "null"
          },
          "id": {
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["id", "name", "created_at", "deleted_at"],
        "title": "Project",
        "type": "object"
      },
      "ProjectCreate": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["name"],
        "title": "ProjectCreate",
        "type": "object"
      },
      "ProjectPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "maxItems": 100,
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "maxLength": 2048,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": ["items", "next_cursor"],
        "title": "ProjectPage",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "postgres": {
            "enum": ["available", "unavailable"],
            "title": "Postgres",
            "type": "string"
          },
          "status": {
            "enum": ["ready", "unavailable"],
            "title": "Status",
            "type": "string"
          },
          "tempo": {
            "enum": ["available", "unavailable"],
            "title": "Tempo",
            "type": "string"
          }
        },
        "required": ["status", "postgres", "tempo"],
        "title": "Readiness",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Sentinel",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/projects": {
      "get": {
        "operationId": "list_projects",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 2048,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          }
        },
        "summary": "List Projects",
        "tags": ["catalog"]
      },
      "post": {
        "operationId": "create_project",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "ETag": {
                "description": "Strong resource ETag",
                "schema": {
                  "type": "string"
                }
              },
              "Location": {
                "description": "Created resource path",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          }
        },
        "summary": "Create Project",
        "tags": ["catalog"]
      }
    },
    "/api/v1/projects/{project_id}": {
      "get": {
        "operationId": "get_project",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "title": "Project Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "ETag": {
                "description": "Strong resource ETag",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem response"
          }
        },
        "summary": "Get Project",
        "tags": ["catalog"]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready"
      }
    }
  }
}
