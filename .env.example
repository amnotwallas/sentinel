# Local development only; change the database password before sharing a host.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel-local-only
POSTGRES_DB=sentinel
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel-local-only@127.0.0.1:5432/sentinel
SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8000
# Set a token for non-loopback native binds; do not commit real tokens.
SENTINEL_API_TOKEN=
SENTINEL_LEASE_SECONDS=60
SENTINEL_HEARTBEAT_SECONDS=15
SENTINEL_MAX_DELIVERIES=3
SENTINEL_POLL_SECONDS=1
SENTINEL_TEMPO_URL=http://127.0.0.1:3200
SENTINEL_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Tests refuse databases whose names do not end in _test.
SENTINEL_TEST_DATABASE_URL=postgresql+psycopg://sentinel:sentinel-local-only@127.0.0.1:5432/sentinel_test
